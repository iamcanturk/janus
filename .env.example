# ============================================================================
# Janus environment template — copy to `.env` and fill in.
# NEVER commit your real .env. BYOK keys are stored encrypted and never logged.
# ============================================================================

# ---- Core infrastructure ----
# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://janus:janus@localhost:5432/janus?schema=public"

# Redis connection string (BullMQ job/task queue)
REDIS_URL="redis://localhost:6379"

# ---- App ----
# Public base URL of the web app
APP_URL="http://localhost:3000"

# Secret used to encrypt stored BYOK keys at rest. Generate a strong random
# value, e.g. `openssl rand -base64 32`. Rotating this invalidates stored keys.
ENCRYPTION_KEY=""

# ---- BYOK connector keys (all optional; keyless sources work without these) --
# Leave blank to disable a connector; the related checks show "skipped (no key)".
SHODAN_API_KEY=""
VIRUSTOTAL_API_KEY=""
OTX_API_KEY=""
CENSYS_API_ID=""
CENSYS_API_SECRET=""
URLSCAN_API_KEY=""
GITHUB_TOKEN=""
HUNTER_API_KEY=""
