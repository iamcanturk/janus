{
  "name": "@janus/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "start": "node dist/index.js",
    "scan": "tsx src/scan-cli.ts",
    "monitor": "tsx src/monitor-cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@janus/checks": "workspace:*",
    "@janus/core": "workspace:*",
    "@janus/db": "workspace:*",
    "@janus/queue": "workspace:*",
    "@janus/report": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
